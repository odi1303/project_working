<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane fx:id="editDishPane" prefHeight="220.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="il.cshaifasweng.OCSFMediatorExample.client.EditDishController">

    <Button fx:id="submitButton" layoutX="32.0" layoutY="28.0" onAction="#submitDish" text="Submit" />

    <HBox layoutX="50" layoutY="70" spacing="10">
        <Label text="Name:" />
        <TextField fx:id="nameTextField" />
    </HBox>

    <HBox layoutX="304.0" layoutY="70.0" spacing="10">
        <Label text="Description:" />
        <TextField fx:id="descriptionTextField" />
    </HBox>

    <HBox layoutX="53.0" layoutY="107.0" spacing="10">
        <Label text="Price:" />
        <TextField fx:id="priceTextField" />
    </HBox>

    <HBox layoutX="300.0" layoutY="119.0" spacing="10">
        <Label text="Image URL:" />
        <TextField fx:id="imageUrlTextField" />
    </HBox>

    <HBox layoutX="53.0" layoutY="144.0" spacing="10">
        <Label text="Sale:" />
        <TextField fx:id="SaleTextField" />
    </HBox>

    <HBox layoutX="27.0" layoutY="174.0">
        <TitledPane expanded="false" layoutX="300" layoutY="161" text="Available Branches">
            <VBox fx:id="availableBranches" spacing="5" />
        </TitledPane>
        <Button fx:id="changeBranchesButton" text="Change Branches" />
    </HBox>

    <HBox layoutX="309.0" layoutY="174.0">
        <TitledPane expanded="false" layoutX="59" layoutY="161" text="Ingredients">
            <VBox fx:id="ingredients" spacing="5" />
        </TitledPane>
        <Button fx:id="changeIngredientsButton" text="Change Ingredients" />
    </HBox>



</AnchorPane>
