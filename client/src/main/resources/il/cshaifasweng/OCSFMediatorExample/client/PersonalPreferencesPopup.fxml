<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.ScrollPane?>

<ScrollPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="il.cshaifasweng.OCSFMediatorExample.client.PersonalPreferencesPopupController">
    <VBox spacing="10">
        <Label fx:id="dishNameLabel" text="Preferences for Dish" />

        <VBox fx:id="preferencesContainer" spacing="10" />

        <HBox spacing="10">
            <Button text="Submit" onAction="#submitPreferences"/>
            <Button text="Cancel" onAction="#cancel"/>
        </HBox>
    </VBox>
</ScrollPane>
