<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="il.cshaifasweng.OCSFMediatorExample.client.CancelDelivey">
   <children>
      <Label layoutX="37.0" layoutY="42.0" text="Cancel Delivery/Table Reservation ">
         <font>
            <Font size="18.0" />
         </font>
      </Label>
      <TextField fx:id="email" layoutX="37.0" layoutY="84.0" prefHeight="26.0" prefWidth="335.0" promptText="Enter the email you ordered the delivery with" />
      <TextField fx:id="id" layoutX="395.0" layoutY="84.0" prefHeight="26.0" prefWidth="166.0" promptText="Enter delivery/reservation ID" />
      <ImageView fx:id="home_icon" fitHeight="62.0" fitWidth="60.0" layoutX="532.0" layoutY="330.0" onMouseClicked="#home_page" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@home.png" />
         </image>
      </ImageView>
      <Button fx:id="submit_button" defaultButton="true" layoutX="37.0" layoutY="347.0" mnemonicParsing="false" onAction="#submit_complain" text="submit " />
      <TextArea fx:id="description" disable="true" editable="false" layoutX="37.0" layoutY="126.0" prefHeight="192.0" prefWidth="514.0" text="IMPORTANT NOTES:&#10;* Delivered delivery cannot be canceled &#10;* Cancellation for delivery within 3 hours from the ordering for free, in 3-1 hours&#10;before the delivery time will be charged with 50% of the order price, after that&#10; will be charged for full price(100%).&#10; * Reservation cancel within a hour before the reserved time will be charged &#10;10 nis, otherwise the cancellation for free.">
         <font>
            <Font name="System Bold" size="13.0" />
         </font>
      </TextArea>
      <ComboBox fx:id="select_cancel" layoutX="395.0" layoutY="43.0" onAction="#selecting_cancel" prefHeight="26.0" prefWidth="166.0" promptText="I want to cancel my..." />
      <Label fx:id="warning_label" layoutX="311.0" layoutY="351.0" textFill="#f20000" />
   </children>
</AnchorPane>
