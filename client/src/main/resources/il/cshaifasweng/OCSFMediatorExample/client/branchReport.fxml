<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane fitToHeight="true" fitToWidth="false" hbarPolicy="ALWAYS" pannable="true" vbarPolicy="NEVER" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="il.cshaifasweng.OCSFMediatorExample.client.BranchReportController">
    <content>
        <HBox alignment="CENTER" spacing="20">

            <BarChart fx:id="orderChart" prefWidth="400">
                <xAxis>
                    <CategoryAxis label="Day" />
                </xAxis>
                <yAxis>
                    <NumberAxis label="Orders" />
                </yAxis>
            </BarChart>
            <Label fx:id="orderSummaryLabel" style="-fx-font-size: 14px; -fx-font-weight: bold;" />

            <BarChart fx:id="peopleChart" prefWidth="400">
                <xAxis>
                    <CategoryAxis label="Day" />
                </xAxis>
                <yAxis>
                    <NumberAxis label="People" />
                </yAxis>
            </BarChart>
            <Label fx:id="peopleSummaryLabel" style="-fx-font-size: 14px; -fx-font-weight: bold;" />

            <BarChart fx:id="complaintsChart" prefWidth="400">
                <xAxis>
                    <CategoryAxis label="Day" />
                </xAxis>
                <yAxis>
                    <NumberAxis label="Complaints" />
                </yAxis>
            </BarChart>
            <Label fx:id="complaintsSummaryLabel" style="-fx-font-size: 14px; -fx-font-weight: bold;" />

            <Button onAction="#goBack" text="Back" />
        </HBox>
    </content>
</ScrollPane>
